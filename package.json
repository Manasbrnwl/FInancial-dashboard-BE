{
  "name": "dashboard",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "sync:equity": "ts-node src/scripts/historicalDataSync.ts --segment equity",
    "sync:futures": "ts-node src/scripts/historicalDataSync.ts --segment futures",
    "sync:options": "ts-node src/scripts/historicalDataSync.ts --segment options",
    "sync:all": "ts-node src/scripts/historicalDataSync.ts --all",
    "test:fyers": "ts-node scripts/test-fyers-history.ts",
    "auth:fyers": "ts-node scripts/fyers-auth.ts",
    "sync:futopt": "ts-node src/scripts/historicalDataSync.ts --segments futures,options"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@types/winston": "^2.4.4",
    "nodemon": "^3.1.10",
    "prisma-erd-generator": "^2.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@getbrevo/brevo": "^5.0.4",
    "@prisma/client": "^6.15.0",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/socket.io": "^3.0.1",
    "@types/ws": "^8.18.1",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "cron-parser": "^5.4.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "fyers-api-v3": "^1.9.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "node-cron": "^3.0.3",
    "prisma": "^6.15.0",
    "protobufjs": "^8.0.0",
    "socket.io": "^4.8.1",
    "upstox-js-sdk": "^2.21.0",
    "winston": "^3.19.0",
    "ws": "^8.18.3"
  }
